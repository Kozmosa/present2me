# 依赖与构建产物
node_modules/
site/
plugins/present2me/tools/excalidraw-viewer/dist/
plugins/present2me/tools/excalidraw-viewer/viewer.js
plugins/present2me/tools/excalidraw-viewer/viewer.css

# 会话本地数据
.zcode/
.DS_Store

# 临时讲解产物（无任务上下文时的草稿图），但保留目录约定
scratch/*
!scratch/.gitkeep

# 个人数据（仓库 public，语料/任务记录不入库），模板随 workflow 内嵌重建
knowledge/*
!knowledge/.gitkeep
tasks/*
!tasks/_template
!tasks/_template/**
archive/*
!archive/.gitkeep

# setup 状态（机器本地，status.sh 写入插件目录）
plugins/present2me/config/setup-state.json

# 查看器服务运行时文件
*.viewer.log
plugins/present2me/tools/excalidraw-viewer/.server.pid
plugins/present2me/tools/excalidraw-viewer/.server.port
plugins/present2me/tools/excalidraw-viewer/assets/
